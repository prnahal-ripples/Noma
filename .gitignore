# Local scratch / previews (generated, not source)
.noma-*-preview.html

# Mobbin capture cache — every downloaded screen per flow, kept locally so
# fetch-refs.py never re-downloads. Not source; docs/research/refs/*.png
# (the bound, in-use captures) are still tracked.
docs/research/refs/_raw/

# Machine-local preview servers. Sessions rewrite this with session-scoped
# /private/tmp paths; see .claude/launch.Noma.json for the shared baseline.
.claude/launch.json
